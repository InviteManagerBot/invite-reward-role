# Bot token: Discord Developer Portal > your application > Bot > Reset Token.
DISCORD_TOKEN=

# Your server's webhook secret, generated by InviteCount.
# Get it with /alert-invites webhook secret ; regenerate it with /alert-invites webhook reset-secret.
WEBHOOK_SECRET=

# Where the webhook server listens. Put a HTTPS reverse proxy in front of it.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook

# SQLite file holding the reward roles.
DATABASE_PATH=data/rewards.db

# Optional: a server ID where slash commands are synced instantly (handy while testing).
DEV_GUILD_ID=

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
